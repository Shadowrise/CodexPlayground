{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kirby-game-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }, { "name": "HISTORY", "class_name": "HistoryStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }, { "tag": "v2", "new_sqlite_classes": ["HistoryStore"] }],
  "ratelimits": [
    { "name": "ADMIN_LOGIN_LIMITER", "namespace_id": "92701", "simple": { "limit": 10, "period": 60 } },
    { "name": "HISTORY_LIMITER", "namespace_id": "92702", "simple": { "limit": 60, "period": 60 } }
  ]
}
